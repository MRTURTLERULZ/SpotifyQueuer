SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

DATABASE_PATH=data/rubik_spotify_queue.duckdb
TOKEN_PATH=data/spotify_tokens.json
MODEL_PATH=models/spotify_skip_model.keras
RAW_HISTORY_DIR=data/raw
MODEL_READY_DIR=data/model_ready
PROCESSED_DIR=data/processed

TIMEZONE=America/New_York
LOCATION_BUCKET=unknown
ACTIVITY_BUCKET=unknown

# Poll less aggressively than the Cursor prototype.
ACTIVE_POLL_SECONDS=8
NEAR_TRACK_END_POLL_SECONDS=3
IDLE_POLL_SECONDS=120
QUIET_HOURS_POLL_SECONDS=900
RATE_LIMIT_MAX_SLEEP_SECONDS=900
INITIAL_ERROR_BACKOFF_SECONDS=5
MAX_ERROR_BACKOFF_SECONDS=300
RESOURCE_LOG_EVERY_N_CYCLES=1
MEMORY_DEBUG_TRACEMALLOC=false
MAX_EVENT_BUFFER_SNAPSHOTS=720
PERSIST_RAW_SPOTIFY_PAYLOADS=false

# Queue only during these local hours. Use 0 and 24 for all day.
QUEUE_START_HOUR=7
QUEUE_END_HOUR=24
QUEUE_READY_CHECK_SECONDS=20
QUEUE_ADD_COOLDOWN_SECONDS=10
QUEUE_TARGET_BUFFER_SIZE=2
QUEUE_RANDOM_POOL_SIZE=50
QUEUE_SCORE_WEIGHT_POWER=4.0
MIN_CANDIDATE_TARGET_SCORE=0.55
CANDIDATE_MIN_TOTAL_PLAYS=2
QUEUE_TRACK_HISTORY_MAX=200
QUEUE_DRY_RUN=false
